// Configuração do back-end do Connexa.
// Cada valor pode ser trocado por uma variável de ambiente com o mesmo nome
// (seções aninhadas usam "__": Connexa__Identidade__Simulacao__Usuarios__0__Chave).
// Os padrões funcionam com o PostgreSQL do docker-compose.yml e do Codespaces.
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "Urls": "http://0.0.0.0:8080",

  "CONNEXA_DB_HOST": "localhost",
  "CONNEXA_DB_PORTA": "5432",
  "CONNEXA_DB_NOME": "connexa",
  "CONNEXA_DB_USUARIO": "connexa",
  "CONNEXA_DB_SENHA": "connexa",

  "Connexa": {
    "Identidade": {
      "Simulacao": {
        // Estudantes fictícios usados enquanto a autenticação real não existe.
        // O primeiro é o padrão; os outros são escolhidos pelo cabeçalho
        // X-Connexa-Usuario-Simulado: <chave>.
        "Usuarios": [
          {
            "Chave": "alice",
            "Id": "00000000-0000-0000-0000-00000000a11c",
            "Nome": "Alice Prado",
            "Email": "alice.prado@instituicao.example"
          },
          {
            "Chave": "bento",
            "Id": "00000000-0000-0000-0000-00000000be70",
            "Nome": "Bento Ramos",
            "Email": "bento.ramos@instituicao.example"
          },
          {
            "Chave": "cecilia",
            "Id": "00000000-0000-0000-0000-0000000ce011",
            "Nome": "Cecília Torres",
            "Email": "cecilia.torres@instituicao.example"
          }
        ]
      }
    }
  }
}
